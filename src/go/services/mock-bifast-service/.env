# ====================================================================
# Mock BI-FAST Service Configuration
# ====================================================================

# Application
ENVIRONMENT=development
VERSION=1.0.0
LOG_LEVEL=debug

# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bifast
DB_USER=root
DB_PASSWORD=password
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=1000

# Admin
ADMIN_TOKEN=docker-admin-token-123

# Notification
NOTIFICATION_ENABLED=false
NOTIFICATION_SERVICE_URL=http://localhost:8082
NOTIFICATION_API_KEY=
NOTIFICATION_TIMEOUT=10s

# BI-FAST Configuration
BIFAST_FEE=2500.0
BIFAST_MAX_AMOUNT=250000000.0
BIFAST_MIN_AMOUNT=10000.0
BIFAST_SUCCESS_RATE=98
