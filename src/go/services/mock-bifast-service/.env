
# Application
ENVIRONMENT=development
VERSION=1.0.0
LOG_LEVEL=debug

# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# Database - Docker container
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bifast
DB_USER=root
DB_PASSWORD=password
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=1000

# Admin
ADMIN_TOKEN=docker-admin-token-123

# Notification - Docker network
NOTIFICATION_ENABLED=false
NOTIFICATION_SERVICE_URL=http://localhost:8082
NOTIFICATION_API_KEY=
NOTIFICATION_TIMEOUT=10s

# ====================================================================
# BI-FAST SPECIFIC CONFIGURATION (NEW)
# ====================================================================

# BI-FAST Transfer Fee (in IDR)
# Default: 2500.0 (Rp 2,500)
BIFAST_FEE=2500.0

# BI-FAST Maximum Transfer Amount (in IDR)
# Default: 250000000.0 (Rp 250,000,000)
BIFAST_MAX_AMOUNT=250000000.0

# BI-FAST Minimum Transfer Amount (in IDR)
# Default: 10000.0 (Rp 10,000)
BIFAST_MIN_AMOUNT=10000.0

# BI-FAST Success Rate (percentage 0-100)
# Used for testing/simulation purposes
# Default: 98 (98% success rate)
BIFAST_SUCCESS_RATE=98