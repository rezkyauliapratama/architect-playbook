        {
          "name": "Transaction Status - Get by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Transaction details present\", function () {",
                  "    var jsonData = pm.response.json();",
